<Project Sdk="Microsoft.NET.Sdk">
  <!-- A Reactor sample's project, for test/fixer-vs-dotnet-format.mjs (#87): test data, never built as it is. It targets
       what upstream's samples target, and measure-samples.mjs converts it to an Isotope project on net10.0. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Reactor\Reactor.csproj" />
  </ItemGroup>
</Project>
