<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Spike J's sources (#75), as the package smoke test's: the folder of packages packed from this branch, which run.mjs
       passes as ISOTOPE_PACKAGES, and nuget.org; no machine-wide feeds. Isotope.* comes from the packed folder only. -->
  <packageSources>
    <clear />
    <add key="isotope-packed" value="%ISOTOPE_PACKAGES%" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="isotope-packed">
      <package pattern="Isotope.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
