{
  "$comment": "Spike J's probes (#75): what each must do when run.mjs builds it, on each framework. 'fail': the build must report each of 'diagnostics' (as errors; 'inGenerated': in a generated file; 'atRecord': no error in a generated file, #78). 'pass': it must build with no warning or error, the generated sources must hold the descriptor of 'record', and must not hold 'generatedLacks'.",
  "probes": [
    {
      "name": "Gen001",
      "expect": "fail",
      "diagnostics": [
        "ISOTOPEGEN001"
      ]
    },
    {
      "name": "NoSetters",
      "expect": "pass",
      "generatedLacks": "GetSetters",
      "record": "PlainRatingElement"
    },
    {
      "name": "UnwiredCallback",
      "expect": "fail",
      "diagnostics": [
        "ISOTOPEGEN002"
      ],
      "atRecord": true
    },
    {
      "name": "WrapEventMismatch",
      "expect": "fail",
      "diagnostics": [
        "ISOTOPEGEN003"
      ],
      "atRecord": true
    },
    {
      "name": "Decorator",
      "expect": "fail",
      "diagnostics": [
        "ISOTOPEGEN004"
      ],
      "atRecord": true
    },
    {
      "name": "InternalOverride",
      "expect": "pass",
      "generatedLacks": "ShallowEqualsCore",
      "record": "OwnRatingElement"
    },
    {
      "name": "InternalEquality",
      "expect": "fail",
      "diagnostics": [
        "CS0117",
        "CS0122"
      ]
    },
    {
      "name": "NameClash",
      "expect": "fail",
      "diagnostics": [
        "CS0121",
        "CS0119"
      ]
    }
  ]
}
