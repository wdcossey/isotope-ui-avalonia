<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spike I (#14): measures control creation against reuse, and keyed moves (remove + insert against Avalonia's
       Controls.Move), headless. Not a test: run it with dotnet run in Release, from the repo root (see Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>15</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
    <!-- Skia and the Fluent theme, as the library's tests use: a window then lays out real text and applies templates. -->
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Isotope.UI.Avalonia\Isotope.UI.Avalonia.csproj" />
  </ItemGroup>
</Project>
