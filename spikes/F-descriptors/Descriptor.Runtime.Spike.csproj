<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spike F (#12): how much of upstream's descriptor runtime compiles against the library's Avalonia seam.
       run-spike.mjs writes the library as it was before the swap (obj/base/, from git at the commit in
       runtime-files.json) and the runtime files from upstream/ at UPSTREAM.lock with only the repo-wide rules
       (obj/runtime/), then builds this project. Nothing here is part of the library. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Isotope.UI</RootNamespace>
    <AssemblyName>Descriptor.Runtime.Spike</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>15</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <SpikeStep Condition="'$(SpikeStep)' == ''">1</SpikeStep>
  </PropertyGroup>
  <Import Project="obj/base/src/Isotope.UI.Avalonia/UpstreamFiles.props" />
  <ItemGroup>
    <Compile Include="obj/base/src/Isotope.UI.Avalonia/Seam/**/*.cs" />
    <Compile Include="obj/runtime/**/*.cs" />
    <Compile Include="Shims/Step1/*.cs" Condition="$(SpikeStep) &gt;= 1" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
  </ItemGroup>
</Project>
