<Project Sdk="Microsoft.NET.Sdk">
  <!-- Isotope.UI.Avalonia: upstream's engine files (ChildReconciler, KeyedListDiff, RenderContext and the helpers
       they need) compiled against our Avalonia implementation of the engine seam (Seam/). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Isotope.UI</RootNamespace>
    <AssemblyName>Isotope.UI.Avalonia</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- C# 15 for upstream's `closed` hierarchies; needs the .NET 11 SDK (global.json). -->
    <LangVersion>15</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <!-- Which vendored upstream files (src/Upstream/) are compiled. -->
  <Import Project="UpstreamFiles.props" />
  <ItemGroup>
    <Compile Include="Seam/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Isotope.UI.Avalonia.Tests" />
  </ItemGroup>
</Project>
