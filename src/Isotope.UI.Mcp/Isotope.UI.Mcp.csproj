<Project Sdk="Microsoft.NET.Sdk">
  <!-- Isotope.UI.Mcp (#60): an MCP server for coding agents that write or migrate Isotope apps, shipped as a dotnet tool
       (command isotope-mcp) over stdio. Phase 1 is authoring help with no running app: the public API (reflection over
       the library and desktop startup it references, and their XML docs), Reactor's names (the migration's own embedded
       tables), the migration itself (its analyzer and code fixes in memory), and the guides (docs/guide, embedded). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Isotope.UI.Mcp</RootNamespace>
    <AssemblyName>Isotope.UI.Mcp</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- A tool built for .NET 10 also runs where only a newer runtime is installed (the .NET 11 SDK's). -->
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <!-- The package (shared metadata in src/Directory.Build.props): a dotnet tool, which carries its dependencies itself,
       so it has none. Its PDB is embedded, so there is no symbols package. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <ToolCommandName>isotope-mcp</ToolCommandName>
    <PackageId>Isotope.UI.Mcp</PackageId>
    <Description>An MCP server for coding agents that write Isotope.UI.Avalonia apps or migrate Microsoft.UI.Reactor ones: search and read the API with its docs, map Reactor names to Isotope's, run the migration on a snippet, and read the guides. A dotnet tool (isotope-mcp), over stdio.</Description>
    <PackageTags>$(PackageTags);mcp;ai;agents</PackageTags>
    <IncludeSymbols>false</IncludeSymbols>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <!-- The pinned SDK's compiler version, as the migration's tests: the desktop startup's ReactorApp.Run<TRoot> is a
         C# 14 extension member, which Roslyn 4.14 (the analyzer's build version) can't read. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- What the API tools reflect over: the tool carries these DLLs and their XML docs, the ones the packages ship. -->
    <ProjectReference Include="..\Isotope.UI.Avalonia\Isotope.UI.Avalonia.csproj" />
    <ProjectReference Include="..\Isotope.UI.Avalonia.Desktop\Isotope.UI.Avalonia.Desktop.csproj" />
    <!-- The migration analyzer and code fixes as a plain assembly, with its embedded tables (its internals). -->
    <ProjectReference Include="..\Isotope.UI.Migration\Isotope.UI.Migration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The licences of what the tool bundles (#68): generated by tools/packaging (pack.mjs, its write-notices option), checked on
         every pack. -->
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\guide\*.md" LogicalName="Isotope.UI.Mcp.guides.%(Filename)%(Extension)" Link="Guides\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Isotope.UI.Mcp.Tests" />
  </ItemGroup>
  <!-- The tool reads the library's types and never runs Avalonia, so the native libraries the desktop startup brings
       (Skia, HarfBuzz, ANGLE for every platform) stay out of its output and its package; with them the package would
       be hundreds of MB. Roslyn's and the SDK's satellite resources stay out too: the tool speaks English. -->
  <PropertyGroup>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- The desktop backends (Win32, X11, macOS, FreeDesktop) and the renderers stay out too (#68): the tool reflects over the
       desktop startup's signatures, which name none of them, and never runs them. Fewer licences to carry, too. -->
  <PropertyGroup>
    <_IsotopeBackendPackages>|Avalonia.Win32|Avalonia.X11|Avalonia.Native|Avalonia.FreeDesktop|Avalonia.FreeDesktop.AtSpi|Avalonia.Skia|Avalonia.HarfBuzz|SkiaSharp|HarfBuzzSharp|MicroCom.Runtime|Tmds.DBus.Protocol|</_IsotopeBackendPackages>
  </PropertyGroup>
  <!-- .mcp/server.json (#68), the MCP server description nuget.org reads for an McpServer package (as the mcpserver
       template packs it). Written at pack time, as the nuspec's repository URL is: its name (io.github.<owner>/<repo>) and
       repository come from the git remote (SourceLink) and its version from MinVer, so no file here names the owner.
       Its description is at most 100 characters (the MCP registry's limit); tools/packaging checks the file. -->
  <PropertyGroup>
    <_IsotopeServerDescription>The Isotope.UI.Avalonia API and guides, and the Reactor migration, for coding agents.</_IsotopeServerDescription>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_IsotopeServerJson</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="_IsotopeServerJson" DependsOnTargets="InitializeSourceControlInformation;MinVer">
    <PropertyGroup>
      <_IsotopeRepository>$([System.Text.RegularExpressions.Regex]::Replace('$(PrivateRepositoryUrl)', '\.git$', ''))</_IsotopeRepository>
      <_IsotopeServerName>$([System.Text.RegularExpressions.Regex]::Replace('$(_IsotopeRepository)', '^https://github\.com/([^/]+)/([^/]+)$', 'io.github.$1/$2'))</_IsotopeServerName>
      <_IsotopeServerJson>$(IntermediateOutputPath)server.json</_IsotopeServerJson>
    </PropertyGroup>
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(_IsotopeServerName)', '^io\.github\.[A-Za-z0-9-]+/[A-Za-z0-9._-]+$'))" Text="server.json needs a https://github.com/&lt;owner&gt;/&lt;repo&gt; git remote (origin), as SourceLink does; got '$(PrivateRepositoryUrl)'." />
    <ItemGroup>
      <_IsotopeServerJsonLine Include="{" />
      <_IsotopeServerJsonLine Include="  &quot;%24schema&quot;: &quot;https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json&quot;," />
      <_IsotopeServerJsonLine Include="  &quot;name&quot;: &quot;$(_IsotopeServerName)&quot;," />
      <_IsotopeServerJsonLine Include="  &quot;description&quot;: &quot;$(_IsotopeServerDescription)&quot;," />
      <_IsotopeServerJsonLine Include="  &quot;version&quot;: &quot;$(PackageVersion)&quot;," />
      <_IsotopeServerJsonLine Include="  &quot;repository&quot;: { &quot;url&quot;: &quot;$(_IsotopeRepository)&quot;, &quot;source&quot;: &quot;github&quot; }," />
      <_IsotopeServerJsonLine Include="  &quot;packages&quot;: [" />
      <_IsotopeServerJsonLine Include="    {" />
      <_IsotopeServerJsonLine Include="      &quot;registryType&quot;: &quot;nuget&quot;," />
      <_IsotopeServerJsonLine Include="      &quot;identifier&quot;: &quot;$(PackageId)&quot;," />
      <_IsotopeServerJsonLine Include="      &quot;version&quot;: &quot;$(PackageVersion)&quot;," />
      <_IsotopeServerJsonLine Include="      &quot;transport&quot;: { &quot;type&quot;: &quot;stdio&quot; }," />
      <_IsotopeServerJsonLine Include="      &quot;packageArguments&quot;: []," />
      <_IsotopeServerJsonLine Include="      &quot;environmentVariables&quot;: []" />
      <_IsotopeServerJsonLine Include="    }" />
      <_IsotopeServerJsonLine Include="  ]" />
      <_IsotopeServerJsonLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_IsotopeServerJson)" Lines="@(_IsotopeServerJsonLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(_IsotopeServerJson)" PackagePath=".mcp/server.json" />
      <FileWrites Include="$(_IsotopeServerJson)" />
    </ItemGroup>
  </Target>
  <Target Name="_IsotopeDropNativeAssets" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$(_IsotopeBackendPackages.Contains('|%(RuntimeCopyLocalItems.NuGetPackageId)|'))" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.AssetType)' == 'native'" />
    </ItemGroup>
  </Target>
</Project>
