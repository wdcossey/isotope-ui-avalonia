<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Reactor -> Isotope migration analyzer and code fixes (#33), run with `dotnet format analyzers` in a project
       whose references have been switched from Reactor to Isotope. It reads the rename table (tools/naming/renames.json,
       #31) and its own tables (WinUI types, Reactor controls with no Isotope counterpart) as embedded data. -->
  <PropertyGroup>
    <!-- Roslyn loads analyzers into the compiler and dotnet format, so netstandard2.0, as the generator project. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <AssemblyName>Isotope.UI.Migration</AssemblyName>
    <RootNamespace>Isotope.UI.Migration</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2008: analyzer release tracking; RS1038: the code fixes share the analyzer's assembly (one file to reference). -->
    <NoWarn>$(NoWarn);RS2008;RS1038</NoWarn>
  </PropertyGroup>
  <!-- The package (#52; shared metadata in src/Directory.Build.props): an analyzer-only package, referenced with
       PrivateAssets="all" for the migration and removed after it. The DLL goes to analyzers/dotnet/cs, nothing to lib/,
       and no dependencies (the host supplies Roslyn). Its PDB is embedded, so there is no symbols package. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Isotope.UI.Migration</PackageId>
    <Description>Moves a Microsoft.UI.Reactor (WinUI) app to Isotope.UI.Avalonia: a Roslyn analyzer with code fixes, run with dotnet format analyzers, that renames what has a counterpart and reports what has none.</Description>
    <PackageTags>$(PackageTags);migration;analyzers;roslyn</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeSymbols>false</IncludeSymbols>
    <DebugType>embedded</DebugType>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_IsotopePackAnalyzer</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="_IsotopePackAnalyzer">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- 4.14: no newer than the compiler of the pinned .NET 11 SDK, as the generator. Workspaces: the code fixes. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\tools\naming\renames.json" LogicalName="Isotope.UI.Migration.renames.json" Link="Tables\renames.json" />
    <EmbeddedResource Include="Tables\winui-types.json" LogicalName="Isotope.UI.Migration.winui-types.json" />
    <EmbeddedResource Include="Tables\reactor-controls.json" LogicalName="Isotope.UI.Migration.reactor-controls.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Isotope.UI.Migration.Tests" />
    <!-- The MCP server (#60) runs the analyzer and its fixes, and reads these tables, as the tests do. -->
    <InternalsVisibleTo Include="Isotope.UI.Mcp" />
    <InternalsVisibleTo Include="Isotope.UI.Mcp.Tests" />
  </ItemGroup>
</Project>
