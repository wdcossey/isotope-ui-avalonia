<Project Sdk="Microsoft.NET.Sdk">
  <!-- Isotope.UI.Avalonia.Desktop (#32): upstream's one-line startup, ReactorApp.Run<TRoot>(title, width, height),
       over a default app builder (Avalonia's platform detection and the Fluent theme). A package of its own, as
       Avalonia.Desktop is: the library stays free of the desktop backends (Win32, X11, macOS) for other heads. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Isotope.UI</RootNamespace>
    <AssemblyName>Isotope.UI.Avalonia.Desktop</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Isotope.UI.Avalonia\Isotope.UI.Avalonia.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Isotope.UI.Avalonia.Tests" />
  </ItemGroup>
</Project>
