<Project Sdk="Microsoft.NET.Sdk">
  <!-- The sample app (#16, #30): a page per area, chosen from a list (#96): the counter and todo, buttons, menus,
       numbers, the split view, rich text, icons and error boundaries, through the public factories. Run it with "dotnet run" (a real window); README.md has the checklist. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Isotope.UI.Avalonia\Isotope.UI.Avalonia.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Icons page's bitmap (#91), drawn for this app. -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>
