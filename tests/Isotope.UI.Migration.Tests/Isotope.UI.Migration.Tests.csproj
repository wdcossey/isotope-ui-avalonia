<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the Reactor -> Isotope migration analyzer and code fixes (#33): Reactor-style code compiled against the
       real library (and Avalonia), analysed, fixed, and compiled again. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>15</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- xunit.v3 3.2.x, as the library's tests. -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <!-- The tests compile their code with the pinned SDK's compiler version (5.12), as dotnet format does: the desktop
         startup's ReactorApp.Run<TRoot> is a C# 14 extension member, which Roslyn 4.14 can't read. The analyzer itself
         is built against 4.14 and runs on either. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The analyzer as a plain assembly (its internals: the tables), and the library and desktop startup, whose
         assemblies (with Avalonia's) are the references the test code compiles against. -->
    <ProjectReference Include="..\..\src\Isotope.UI.Migration\Isotope.UI.Migration.csproj" />
    <ProjectReference Include="..\..\src\Isotope.UI.Avalonia\Isotope.UI.Avalonia.csproj" />
    <ProjectReference Include="..\..\src\Isotope.UI.Avalonia.Desktop\Isotope.UI.Avalonia.Desktop.csproj" />
  </ItemGroup>
</Project>
