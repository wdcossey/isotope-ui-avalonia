<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The smoke test's sources (#52): the folder of packed packages, which tools/packaging/pack.mjs passes as
       ISOTOPE_PACKAGES, and nuget.org; no machine-wide feeds. Isotope.* comes from the packed folder only, so a copy of
       the same version on nuget.org (once one is published, or another account's) is never tested instead. -->
  <packageSources>
    <clear />
    <add key="isotope-packed" value="%ISOTOPE_PACKAGES%" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="isotope-packed">
      <package pattern="Isotope.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
