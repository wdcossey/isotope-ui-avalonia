<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org only (no machine-wide feeds); tools/packaging/pack.mjs adds the folder of packed packages
       (RestoreAdditionalProjectSources) and a fresh packages folder (NUGET_PACKAGES), so nothing cached is reused. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
