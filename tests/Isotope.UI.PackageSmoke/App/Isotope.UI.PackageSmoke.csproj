<Project Sdk="Microsoft.NET.Sdk">
  <!-- A tiny app on the packed packages (#52), run headless by tools/packaging/pack.mjs: see Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Each framework the library ships for (#67); tools/packaging/pack.mjs runs each. -->
    <TargetFrameworks>net9.0;net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- No LangVersion: a consumer's default (C# 14 on net10.0, 15 on net11.0), not the C# 15 the library is built with.
         Except net9.0, whose default C# 13 can't call ReactorApp.Run (a C# 14 extension member): an app on net9.0 sets
         LangVersion 14, as the package READMEs say. -->
    <LangVersion Condition="'$(TargetFramework)' == 'net9.0'">14</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only the desktop package: the library, and its bundled generator, must come with it. -->
    <PackageReference Include="Isotope.UI.Avalonia.Desktop" Version="$(IsotopeVersion)" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
  </ItemGroup>
</Project>
